# ============================================
# ADGENXAI PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local for local development
# Configure these in Netlify Dashboard > Site settings > Environment variables

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app
NEXT_PUBLIC_API_URL=https://your-site.netlify.app/api

# ============================================
# NETLIFY CONFIGURATION
# ============================================
NETLIFY_AUTH_TOKEN=your_netlify_auth_token
NETLIFY_SITE_ID=your_site_id

# Netlify Blobs Storage (for caching)
# These are auto-populated by Netlify in production
# NETLIFY_BLOBS_CONTEXT=production

# ============================================
# GITHUB CONFIGURATION
# ============================================
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_PAT=your_personal_access_token_here
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key
GITHUB_INSTALLATION_ID=your_installation_id

# ============================================
# VIDEO GENERATION PROVIDERS
# ============================================

# LongCat (Primary Provider)
LONGCAT_API_KEY=sk-your-longcat-api-key-here
LONGCAT_BASE_URL=https://api.longcat.ai/v1
USE_LONGCAT=1
DEBUG_LONGCAT=0

# OpenAI Sora (Alternative Provider)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
NEXTAUTH_URL=https://your-site.netlify.app
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl
JWT_SECRET=your-jwt-secret-here

# Supabase Authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# DATABASE & STORAGE
# ============================================
# Supabase Database URL
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis (for caching and queues)
REDIS_URL=redis://your-redis-url:6379
REDIS_TOKEN=your-redis-token

# ============================================
# TELEMETRY & MONITORING
# ============================================
ENABLE_TELEMETRY=true
DEBUG_TELEMETRY=false
TELEMETRY_ENDPOINT=https://your-telemetry.example/v1/events
TELEMETRY_API_KEY=your-telemetry-api-key

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ============================================
# CACHING CONFIGURATION
# ============================================
CACHE_METRICS_ENABLED=true
CACHE_TTL_VIDEO=86400
CACHE_TTL_IMAGE=43200
CACHE_TTL_METADATA=3600

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_WEBHOOK_PROCESSING=true
ENABLE_VIDEO_GENERATION=true
ENABLE_CACHE_WARMING=true
ENABLE_AGENT_DEPLOYMENT=false

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
NOTIFICATION_EMAIL=notifications@example.com

# ============================================
# ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# ============================================
# DEVELOPMENT ONLY
# ============================================
# DEBUG_MODE=false
# LOG_LEVEL=info
