# GitHub Configuration
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_PAT=your_personal_access_token_here

# Netlify Configuration
NETLIFY_AUTH_TOKEN=your_netlify_auth_token
NETLIFY_SITE_ID=your_site_id

# LongCat Configuration (replaces OpenAI)
LONGCAT_API_KEY=sk-your-longcat-api-key
LONGCAT_BASE_URL=https://api.longcat.ai/v1

# Feature flag for safe rollback (set to 0 to disable)
USE_LONGCAT=1

# Application Configuration
NODE_ENV=production
ENABLE_WEBHOOK_PROCESSING=false

# Optional - Debug flags for local development
DEBUG_WEBHOOK_PROCESSING=false
DEBUG_LONGCAT=false
