# ==============================================================================
# BEE-SHIP AUTONOMOUS PUBLISHING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# GitHub Configuration
# --------------------
# Used for GitHub webhook integration and repository access
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_PAT=your_personal_access_token_here

# Netlify Configuration
# ---------------------
# Used for Netlify API access and deployment management
NETLIFY_AUTH_TOKEN=your_netlify_auth_token
NETLIFY_SITE_ID=your_site_id

# Application Configuration
# -------------------------
NODE_ENV=production
ENABLE_WEBHOOK_PROCESSING=false

# Webhook Security
# ---------------
# Secret for verifying webhook signatures (HMAC-SHA256)
# Generate a strong random string: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret_key_here

# AI Sensory Cortex Configuration
# -------------------------------
# URL to your AI processing backend (optional)
SENSORY_CORTEX_URL=https://your-cortex-site.netlify.app
NEXT_PUBLIC_SENSORY_CORTEX_URL=https://your-cortex-site.netlify.app

# ==============================================================================
# SOCIAL MEDIA PLATFORM CREDENTIALS
# ==============================================================================

# Instagram (via Facebook Graph API)
# ----------------------------------
# Required for Instagram post and story publishing
# Get credentials from: https://developers.facebook.com/
# 
# 1. Create a Facebook App
# 2. Add Instagram Graph API product
# 3. Get Page Access Token with instagram_basic, instagram_content_publish permissions
# 4. Get Instagram Business Account ID
#
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_page_access_token
#
# Note: Access tokens should be long-lived (60 days). Refresh before expiry.
# Generate long-lived token: https://developers.facebook.com/docs/facebook-login/guides/access-tokens/get-long-lived

# YouTube (via Google APIs)
# -------------------------
# Required for YouTube video uploads
# Get credentials from: https://console.cloud.google.com/
#
# 1. Create a Google Cloud Project
# 2. Enable YouTube Data API v3
# 3. Create OAuth 2.0 credentials
# 4. Get refresh token using OAuth flow
#
YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
#
# To get refresh token, run OAuth flow with scopes:
# - https://www.googleapis.com/auth/youtube.upload
# - https://www.googleapis.com/auth/youtube

# TikTok (via TikTok Content Posting API)
# ---------------------------------------
# Required for TikTok video publishing
# Get credentials from: https://developers.tiktok.com/
#
# 1. Create a TikTok Developer account
# 2. Register your application
# 3. Request access to Content Posting API
# 4. Get client credentials and user access token
#
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id
#
# Note: Access tokens expire. Implement refresh flow in production.
# Scopes required: user.info.basic, video.publish

# ==============================================================================
# OPTIONAL INTEGRATIONS
# ==============================================================================

# Supabase (for data storage)
# ---------------------------
# Used for storing campaign data, analytics, and asset management
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# BEE Agent (AI Content Generation)
# ---------------------------------
# External AI service for content generation
BEE_API_URL=https://www.adgenxai.pro/api
BEE_API_KEY=your_bee_agent_api_key

# ==============================================================================
# DEVELOPMENT & TESTING
# ==============================================================================

# Local Development
# ----------------
# Set to 'development' for local testing
# NODE_ENV=development

# Rate Limiting
# -------------
# Requests per minute per IP (default: 10)
RATE_LIMIT_PER_MINUTE=10

# Logging
# -------
# Set log level: debug, info, warn, error
LOG_LEVEL=info

# ==============================================================================
# DEPLOYMENT NOTES
# ==============================================================================
#
# 1. Never commit this file with real credentials
# 2. Set all environment variables in Netlify Dashboard:
#    Site Settings > Environment Variables
# 3. For sensitive keys, use Netlify's encrypted environment variables
# 4. Rotate credentials regularly (recommended: every 90 days)
# 5. Use different credentials for development and production
#
# ==============================================================================
