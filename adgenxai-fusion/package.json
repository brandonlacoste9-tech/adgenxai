{
  "name": "adgenxai-fusion",
  "version": "2.0.0",
  "description": "AdgenxAI Fusion v2 - Voice-Enabled Gemini Orchestration Platform",
  "main": "app.py",
  "scripts": {
    "start": "python app.py",
    "rehearse": "bash rehearse.sh",
    "test": "bash test_fusion_endpoints.sh",
    "docker:build": "docker build -t adgenxai-fusion:latest .",
    "docker:run": "docker run -p 8000:8000 adgenxai-fusion:latest",
