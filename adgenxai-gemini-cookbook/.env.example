# Environment Configuration for AdgenxAI Gemini Cookbook

# Google Gemini API Key (Required)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Project ID
GOOGLE_PROJECT_ID=adgenxai-production

# Optional: Google Cloud Region
GOOGLE_REGION=us-central1

# AdgenxAI Configuration
BEEHIVE_MODE=true
NEUROMORPHIC_PROCESSING=true
AGENT_SWARM_ENABLED=true

# Performance Settings
MAX_CONCURRENT_REQUESTS=100
TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3

# Monitoring
ENABLE_TELEMETRY=true
LOG_LEVEL=INFO

# Security
API_RATE_LIMIT=1000
CONTENT_FILTERING=true