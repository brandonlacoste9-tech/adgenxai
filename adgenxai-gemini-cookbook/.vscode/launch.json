    {
      "name": "🎨 Multimodal Demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/quickstart/multimodal_input.py",
      "console": "integratedTerminal"
    },
    {
      "name": "🔧 Function Calling Demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/tools/function_calling.py",
      "console": "integratedTerminal"
